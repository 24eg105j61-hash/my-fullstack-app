# ===================================================
# Student Planner - Environment Configuration Template
# ===================================================

# -----------------
# Backend Settings
# -----------------
PORT=5001
NODE_ENV=development

# PostgreSQL Connection String
# Local example: postgresql://postgres:postgres@localhost:5432/student_planner
# Production example (Render / Supabase / Neon): postgresql://user:password@ep-host.region.render.com/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/student_planner

# Allowed Frontend Origins for CORS (comma-separated or * for wildcard)
CLIENT_URL=http://localhost:5173,https://my-student-planner.vercel.app

# ------------------
# Frontend Settings (Vercel)
# ------------------
# In Local Dev: leave empty to use Vite /api proxy
# In Production (Vercel): set to your deployed Render backend URL
VITE_API_BASE_URL=https://student-planner-api.onrender.com/api
